# =============================================================================
# Portal de Inventário de TI · variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no Render (produção).
# NUNCA commitar valores reais.
# =============================================================================

# --- Autenticação ------------------------------------------------------------
# cloudflare = valida o JWT Cf-Access-Jwt-Assertion (padrão em produção)
# local      = sem login, só fora de produção (padrão do `npm run dev`)
AUTH_MODE=cloudflare
ENVIRONMENT=production

# Team domain do Cloudflare Zero Trust, ex.: talentos.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag da Access App "Portal TI Talentos"
CF_ACCESS_AUD=

# Allowlist no app (defesa em profundidade, opcional)
ALLOWED_EMAILS=informatica@talentosconsultoria.com.br
ALLOWED_DOMAIN=talentosconsultoria.com.br

# --- Dados (Firestore via firebase-admin, lido no servidor) ---------------------
# Conteúdo COMPLETO do serviceAccountKey.json, numa linha só.
FIREBASE_SERVICE_ACCOUNT_JSON=

# firestore | mock. Se vazio: firestore quando há credencial; mock fora de
# produção quando não há. Em produção, mock é recusado.
DATA_SOURCE=
